<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>AI Page Compiler – SEO Intelligence</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="css/styles.css">
</head>

<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="index.html">SEO Intelligence & Compiler</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div id="navbarContent" class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="index.html">Overview</a></li>
                <li class="nav-item"><a class="nav-link" href="seo-dashboard.html">SEO Dashboard</a></li>
                <li class="nav-item"><a class="nav-link active" href="compiler-dashboard.html">Page Compiler</a></li>
                <li class="nav-item"><a class="nav-link" href="reports.html">Reports</a></li>
            </ul>
        </div>
    </div>
</nav>

<main class="container" style="padding-top: 6rem;">
    <h2 class="mb-4">Automated AI Page Compiler</h2>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5>Generate SEO-Optimised Page Content</h5>
            <p class="text-muted">Enter a topic and keywords. AI will generate full SEO elements.</p>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Page Topic</label>
                    <input class="form-control" placeholder="e.g. Industrial Flooring for Warehouses" id="topicInput">
                </div>

                <div class="col-md-6">
                    <label class="form-label">Target Keywords (comma separated)</label>
                    <input class="form-control" placeholder="industrial flooring, anti-slip floors" id="keywordsInput">
                </div>
            </div>

            <button class="btn btn-primary btn-lg mt-3 w-100" onclick="generatePage()">Generate SEO Content</button>

        </div>
    </div>

    <div id="outputSection" style="display:none;">
        <h4 class="mt-4">Generated SEO Elements</h4>

        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h6>Title</h6>
                <p id="title"></p>

                <h6>Meta Description</h6>
                <p id="meta"></p>

                <h6>H1</h6>
                <p id="h1"></p>

                <h6>URL Slug</h6>
                <p id="slug"></p>

                <h6>Section Outline</h6>
                <ul id="outline"></ul>
            </div>
        </div>

        <button class="btn btn-success w-100 btn-lg">Publish to WordPress (placeholder)</button>
    </div>
</main>

<script src="js/compiler.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
